//Note: We have created 'libqti-tinycompress' below lib in android.bp
// for RBVM-LA15.2.0 (_sdv _cdcsdv), to support APEX
// in audio components and also to avoid conflict
// as the this bin component is common among many other Software-Images

//********* update the Android.mk also if this Android.bp is updated,
//          as both have common properties                 *********

cc_library_shared {

    name: "libqti-tinycompress",
    vendor: true,

    srcs: [
            "compress.c",
            "utils.c",
            "compress_hw.c",
            "compress_plugin.c",
            "snd_utils.c",
            ],

    shared_libs: [
        "libcutils",
        "libutils",
        ],

    include_dirs: [
        "vendor/qcom/opensource/tinycompress/include",
        ],

    cflags: [
            "-Wno-macro-redefined",
            "-Wno-unused-function",
        ]
        + select(soong_config_variable("qti", " AUDIO_FEATURE_ENABLED_EXTENDED_COMPRESS_FORMAT"),
        {
            true: ["-DENABLE_EXTENDED_COMPRESS_FORMAT"],
            default: [],
        }),

    apex_available: [
        "//apex_available:platform",
        "com.google.display_safety.har",
        "com.google.display_safety.har.update",
        "com.google.display_safety.har.stub",
    ],
    min_sdk_version: "34",

    enabled: select(soong_config_variable("qti", "ENABLE_TINYCOMPRESS"), {
        true: true,
        default: false,
    }),
}


cc_binary {

    name: "qticplay",
    vendor: true,

    srcs: [
            "cplay.c",
            ],

    shared_libs: [
        "libcutils",
        "libutils",
        "libqti-tinycompress",
        ],

    include_dirs: [
        "vendor/qcom/opensource/tinycompress/include",
        ],

    cflags: [
        "-Wno-macro-redefined",
        "-Wno-unused-function"
        ],

    apex_available: [
        "//apex_available:platform",
        "com.google.display_safety.har",
        "com.google.display_safety.har.update",
        "com.google.display_safety.har.stub",
    ],
    min_sdk_version: "34",


    enabled: select(soong_config_variable("qti", "ENABLE_TINYCOMPRESS"), {
        true: true,
        default: false,
    }),
}
